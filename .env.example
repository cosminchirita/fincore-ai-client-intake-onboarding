# Runtime
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://fincore:fincore_dev_only@db:5432/fincore
INTERNAL_API_KEY=replace-with-at-least-32-random-characters
DASHBOARD_API_KEY=replace-with-a-separate-dashboard-key

# Reliable workflow dispatch
N8N_WEBHOOK_URL=http://n8n:5678/webhook/fincore-lead-intake
OUTBOX_POLL_SECONDS=3
OUTBOX_MAX_ATTEMPTS=8

# AI: mock is zero-cost and deterministic; openai enables live extraction
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Mailpit local SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FinCore Accounting <onboarding@fincore.demo>
INTERNAL_NOTIFICATION_EMAIL=team@fincore.demo

# Upload controls
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.xlsx,.xls,.csv,.docx
RETENTION_DAYS=90

# n8n
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Bucharest
