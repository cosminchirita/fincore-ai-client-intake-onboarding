      "credentials": {
        "httpHeaderAuth": {
          "id": "QglJN3n06SMS3PJ6",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\nconst plans = [];\nif (lead.already_processed) return plans;\nif (lead.status === 'qualified') {\n  plans.push({json: {lead_id: lead.id, template: 'qualified'}});\n} else if (lead.status === 'awaiting_information') {\n  plans.push({json: {lead_id: lead.id, template: 'missing_information'}});\n}\nplans.push({json: {lead_id: lead.id, template: 'internal_notification'}});\nreturn plans;"
      },
      "id": "090f2062-a070-4022-b4ce-3d7260383494",
      "name": "Build Notification Plan",
      "type": "n8n-nodes-base.code",
